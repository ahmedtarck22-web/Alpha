                                <rect x="54" y="76" width="12" height="14" rx="5" fill="#e9b896"/>
                                <ellipse cx="60" cy="58" rx="20" ry="22" fill="#f3c6a5"/>
                                <circle cx="43" cy="42" r="9" fill="#6d28d9"/>
                                <circle cx="54" cy="39" r="9" fill="#7c3aed"/>
                                <circle cx="67" cy="39" r="9" fill="#6d28d9"/>
                                <circle cx="77" cy="43" r="8" fill="#5b21b6"/>
                                <ellipse cx="60" cy="34" rx="30" ry="7" fill="#c8964e" stroke="#fef08a" stroke-width="1"/>
                                <path d="M42 33 C42 18, 78 18, 78 33 Z" fill="#dfb06a"/>
