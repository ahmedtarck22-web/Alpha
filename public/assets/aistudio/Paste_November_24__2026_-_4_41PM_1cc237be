                        </button>
                        <div class="h-px bg-[#ffd18a]/35 w-full"></div>
                        <button onclick="triggerQuickTool('البحث العميق')" class="flex items-center gap-2.5 text-xs sm:text-sm font-semibold text-[#ffd18a] hover:brightness-110 transition text-right py-0.5">
