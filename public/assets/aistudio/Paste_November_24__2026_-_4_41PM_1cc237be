            <!-- TAB 2: QUIZZES VIEW -->
            <div id="view-quizzes" class="tab-view hidden flex-1 flex-col gap-3 py-2">
                <div class="flex items-center justify-between liquid-glass rounded-2xl p-4">
                    <div>
                        <h3 class="text-base sm:text-lg font-extrabold gold-text-reflection">الاختبارات التفاعلية</h3>
                        <p class="text-xs text-[#ffe3b0]/75 mt-0.5">اختبر مستواك واكسب نقاطاً تضاف لإنجازاتك</p>
