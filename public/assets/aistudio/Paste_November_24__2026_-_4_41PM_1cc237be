                        <h3 class="text-lg font-extrabold gold-text-reflection">تسجيل الدخول - Alpha Go</h3>
                    </div>
                    <button onclick="closeAuthModal()" aria-label="إغلاق" class="w-8 h-8 rounded-full bg-[#392252]/85 border border-[#ffd18a]/65 flex items-center justify-center text-[#ffd18a] hover:bg-[#4c2e6e] transition">
                        ✕
                    </button>
                </div>

                <!-- Student Status Badge -->
                <div id="loggedInStatusBox" class="hidden mb-4 p-3 rounded-2xl bg-[#ffd18a]/15 border border-[#ffd18a]/65 text-center">
                    <p class="text-xs text-[#ffd18a]/90">مرحباً بك يا بطل:</p>
                    <p id="currentStudentName" class="text-sm font-extrabold text-[#ffd18a] mt-0.5">أحمد محمد</p>
                </div>

                <!-- Login Form Widget -->
                <form id="loginForm" onsubmit="submitLogin(event)" class="space-y-3">
                    <div>
                        <label class="block text-xs font-bold text-[#ffd18a] mb-1">اسم الطالب أو البريد الإلكتروني</label>
                        <input id="loginUsername" type="text" required placeholder="أدخل اسمك أو بريدك..." class="w-full rounded-2xl bg-[#1a0e2e]/75 border-[1.4px] border-[#ffd18a]/65 px-3.5 py-2.5 text-xs sm:text-sm text-[#ffd18a] placeholder-[#ffd18a]/55 focus:outline-none focus:border-[#ffd18a] shadow-[0_0_12px_rgba(255,209,138,0.12)]">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#ffd18a] mb-1">كلمة المرور</label>
                        <input id="loginPassword" type="password" required placeholder="••••••••" class="w-full rounded-2xl bg-[#1a0e2e]/75 border-[1.4px] border-[#ffd18a]/65 px-3.5 py-2.5 text-xs sm:text-sm text-[#ffd18a] placeholder-[#ffd18a]/55 focus:outline-none focus:border-[#ffd18a] shadow-[0_0_12px_rgba(255,209,138,0.12)]">
                    </div>
                    <button type="submit" class="w-full py-2.5 mt-1 rounded-full bg-gradient-to-r from-[#ffd18a] to-[#ffe3b0] border border-[#fff2d6] text-[#1a0c33] text-sm font-extrabold hover:brightness-110 shadow-[0_0_18px_rgba(255,209,138,0.35)] transition">
                        دخول إلى حسابي ✨
                    </button>
                </form>

                <!-- Quick Guest / Logout Actions -->
                <div class="mt-3 pt-3 border-t border-[#ffd18a]/35 flex items-center justify-between text-xs">
                    <button type="button" onclick="quickDemoLogin()" class="text-[#ffd18a] font-bold hover:underline">دخول تجريبي سريع</button>
                    <button type="button" onclick="performLogout()" class="text-[#ffd18a]/80 font-semibold hover:text-[#ffd18a] hover:underline">تسجيل الخروج</button>
                </div>
            </div>
        </div>

    </main>

    <script>
        let isPhoneMode = false;
        let isPlusMenuOpen = false;
        let currentLang = 'EN';
        let toastTimeout = null;

        const appStage = document.getElementById('appStage');
        const viewModeText = document.getElementById('viewModeText');
        const drawerOverlay = document.getElementById('drawerOverlay');
        const drawerPanel = document.getElementById('drawerPanel');

        function showToast(text) {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toastMessage');
            toastMessage.innerText = text;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            toast.classList.add('opacity-100');

            if (toastTimeout) clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.remove('opacity-100');
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 2400);
        }

        function openDrawer() {
            drawerOverlay.classList.remove('opacity-0', 'pointer-events-none');
            drawerOverlay.classList.add('opacity-100');
            drawerPanel.classList.remove('drawer-closed');
            drawerPanel.classList.add('drawer-open');
            resizeDrawerCanvas();
        }

        function dismissDrawer() {
            drawerPanel.classList.remove('drawer-open');
            drawerPanel.classList.add('drawer-closed');
            drawerOverlay.classList.remove('opacity-100');
            drawerOverlay.classList.add('opacity-0', 'pointer-events-none');
        }

        function toggleViewMode() {
            isPhoneMode = !isPhoneMode;
            if (isPhoneMode) {
                appStage.classList.remove('max-w-5xl', 'h-[84vh]', 'rounded-3xl');
                appStage.classList.add('phone-frame');
                viewModeText.innerText = 'التحويل للمعاينة الكاملة';
            } else {
                appStage.classList.remove('phone-frame');
                appStage.classList.add('max-w-5xl', 'h-[84vh]', 'rounded-3xl');
                viewModeText.innerText = 'التحويل لشاشة جوال';
            }
            setTimeout(() => {
                resizeMainCanvas();
                resizeDrawerCanvas();
            }, 350);
        }

        function togglePlusMenu() {
            isPlusMenuOpen = !isPlusMenuOpen;
            const popover = document.getElementById('plusMenuPopover');
            const plusSvg = document.getElementById('plusIconSvg');
            if (isPlusMenuOpen) {
                popover.classList.remove('plus-popover-hidden');
                popover.classList.add('plus-popover-visible');
                plusSvg.classList.add('rotate-45');
            } else {
                popover.classList.remove('plus-popover-visible');
                popover.classList.add('plus-popover-hidden');
                plusSvg.classList.remove('rotate-45');
            }
        }

        function selectGrade(btn, gradeName) {
            document.querySelectorAll('.grade-pill').forEach(el => el.classList.remove('pill-active'));
            btn.classList.add('pill-active');
            document.getElementById('selectedGradeHint').innerHTML = `تم اختيار منهج: <span class="text-[#ffd18a] font-bold">${gradeName}</span> ✅`;
            const libSub = document.getElementById('libraryGradeSubtitle');
            if (libSub) libSub.innerText = `الكتب والملخصات المعتمدة لـ (${gradeName})`;
            showToast(`تم تفعيل منهج ${gradeName}`);
        }

        function triggerQuickTool(toolName) {
            if (isPlusMenuOpen) togglePlusMenu();
            const input = document.getElementById('promptInput');
            input.placeholder = `اكتب سؤالك لـ (${toolName})...`;
            input.focus();
            showToast(`تم تفعيل وضع: ${toolName}`);
        }

        function sendPrompt() {
            const input = document.getElementById('promptInput');
            const text = input.value.trim();
            if (!text) return;

            const feed = document.getElementById('chatFeed');
            const userBubble = document.createElement('div');
            userBubble.className = 'self-start bg-[#3a225d]/90 border border-[#ffd18a]/30 text-[#fff3d6] text-xs sm:text-sm px-4 py-2 rounded-2xl rounded-tr-sm max-w-[80%] shadow';
            userBubble.innerText = text;
            feed.appendChild(userBubble);

            input.value = '';

            setTimeout(() => {
                const aiBubble = document.createElement('div');
                aiBubble.className = 'self-end bg-[#221238]/95 border border-[#ffd18a]/45 text-[#ffd18a] text-xs sm:text-sm px-4 py-2 rounded-2xl rounded-tl-sm max-w-[85%] shadow';
                aiBubble.innerText = `أهلاً بك! جاري تجهيز شرح مبسط حول "${text}" ✨`;
                feed.appendChild(aiBubble);
            }, 400);
        }

        function switchTab(tabKey, tabLabel) {
            document.querySelectorAll('.tab-view').forEach(view => {
                view.classList.add('hidden');
                view.classList.remove('flex');
            });
            const activeView = document.getElementById(`view-${tabKey}`);
            if (activeView) {
                activeView.classList.remove('hidden');
                activeView.classList.add('flex');
            }
            if (tabLabel) showToast(`القسم: ${tabLabel}`);
        }

        function toggleLanguage() {
            const thumb = document.getElementById('langThumb');
            const enLabel = document.getElementById('langEnLabel');
            const arLabel = document.getElementById('langArLabel');
            if (currentLang === 'EN') {
                currentLang = 'AR';
                thumb.style.transform = 'translateX(44px)';
                enLabel.classList.replace('text-[#1a0c33]', 'text-[#ffd18a]');
                arLabel.classList.replace('text-[#ffd18a]', 'text-[#1a0c33]');
                showToast('تم تغيير اللغة إلى: العربية');
            } else {
                currentLang = 'EN';
                thumb.style.transform = 'translateX(0px)';
                arLabel.classList.replace('text-[#1a0c33]', 'text-[#ffd18a]');
                enLabel.classList.replace('text-[#ffd18a]', 'text-[#1a0c33]');
                showToast('Language switched to: English');
            }
        }

        function handleItemClick(itemKey) {
            dismissDrawer();
            if (itemKey === 'curriculum') {
                switchTab('library', 'المكتبة والمنهج الدراسي');
            } else if (itemKey === 'achievements') {
                switchTab('quizzes', 'الاختبارات والإنجازات');
            } else if (itemKey === 'account') {
                openAuthModal();
            } else if (itemKey === 'contact') {
                switchTab('home', 'تواصل مع المساعد الذكي');
                document.getElementById('promptInput').focus();
            } else if (itemKey === 'settings') {
                showToast('إعدادات التطبيق والواقع المختلط ⚙️');
            } else if (itemKey === 'logout') {
                openAuthModal();
            }
        }

        function openAuthModal() {
            const modal = document.getElementById('authModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeAuthModal() {
            const modal = document.getElementById('authModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function submitLogin(e) {
            e.preventDefault();
            const nameVal = document.getElementById('loginUsername').value.trim() || 'طالب Alpha Go';
            document.getElementById('currentStudentName').innerText = nameVal;
            document.getElementById('loggedInStatusBox').classList.remove('hidden');
            closeAuthModal();
            showToast(`أهلاً بك يا ${nameVal} ✨`);
        }

        function quickDemoLogin() {
            document.getElementById('loginUsername').value = 'مستكشف الحضارة';
            document.getElementById('currentStudentName').innerText = 'مستكشف الحضارة';
            document.getElementById('loggedInStatusBox').classList.remove('hidden');
            closeAuthModal();
            showToast('تم تسجيل الدخول كـ مستكشف الحضارة ✨');
        }

        function performLogout() {
            document.getElementById('loggedInStatusBox').classList.add('hidden');
            document.getElementById('loginUsername').value = '';
            document.getElementById('loginPassword').value = '';
            closeAuthModal();
            showToast('تم تسجيل الخروج بنجاح');
        }

        const mainCanvas = document.getElementById('mainBgCanvas');
        const mainCtx = mainCanvas.getContext('2d');
        let mainStars = [];

        function resizeMainCanvas() {
            const rect = appStage.getBoundingClientRect();
            mainCanvas.width = rect.width || 390;
            mainCanvas.height = rect.height || 820;
            mainStars = Array.from({ length: 100 }, () => ({
                x: Math.random() * mainCanvas.width,
                y: Math.random() * mainCanvas.height,
                r: Math.random() * 1.4 + 0.3,
                a: Math.random() * 0.38 + 0.08
            }));
        }

        function drawMainBg() {
            mainCtx.clearRect(0, 0, mainCanvas.width, mainCanvas.height);
            mainStars.forEach(s => {
                mainCtx.fillStyle = `rgba(255, 228, 193, ${s.a})`;
                mainCtx.beginPath();
                mainCtx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
                mainCtx.fill();
            });
            requestAnimationFrame(drawMainBg);
        }

        const drawerCanvas = document.getElementById('drawerBgCanvas');
        const drawerCtx = drawerCanvas.getContext('2d');
        let drawerStars = [];

        function resizeDrawerCanvas() {
            const rect = drawerPanel.getBoundingClientRect();
            drawerCanvas.width = rect.width || 310;
            drawerCanvas.height = rect.height || 820;
            drawerStars = Array.from({ length: 140 }, () => ({
                x: Math.random() * drawerCanvas.width,
                y: Math.random() * drawerCanvas.height,
                r: Math.random() * 1.6 + 0.3,
                a: Math.random() * 0.45 + 0.1
            }));
        }

        function drawDrawerBg() {
            drawerCtx.clearRect(0, 0, drawerCanvas.width, drawerCanvas.height);
            const grad = drawerCtx.createRadialGradient(
                drawerCanvas.width * 0.35, drawerCanvas.height * 0.38, 0,
                drawerCanvas.width * 0.35, drawerCanvas.height * 0.38, drawerCanvas.width * 0.8
            );
            grad.addColorStop(0, 'rgba(130, 62, 120, 0.18)');
            grad.addColorStop(1, 'transparent');
            drawerCtx.fillStyle = grad;
            drawerCtx.fillRect(0, 0, drawerCanvas.width, drawerCanvas.height);

            drawerStars.forEach(s => {
                drawerCtx.fillStyle = `rgba(255, 228, 193, ${s.a})`;
                drawerCtx.beginPath();
                drawerCtx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
                drawerCtx.fill();
            });
            requestAnimationFrame(drawDrawerBg);
        }

        window.addEventListener('load', () => {
            resizeMainCanvas();
            resizeDrawerCanvas();
            requestAnimationFrame(drawMainBg);
            requestAnimationFrame(drawDrawerBg);
        });

        window.addEventListener('resize', () => {
            resizeMainCanvas();
            resizeDrawerCanvas();
        });
    </script>
</body>
</html>