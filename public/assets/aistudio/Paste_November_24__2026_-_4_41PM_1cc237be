        <!-- 1. TOP APP BAR (Single Control Center Icon + Centered App Icon) -->
        <div dir="ltr" class="relative z-10 w-full px-5 pt-2.5 pb-1 flex items-center justify-between shrink-0">
            <!-- Left Menu Button (Single Control Center Trigger) -->
            <button onclick="openDrawer()" aria-label="فتح لوحة التحكم" class="w-10 h-10 rounded-full bg-[#241638]/85 border-[1.5px] border-[#ffd18a]/65 flex items-center justify-center text-[#ffd18a] hover:scale-105 active:scale-95 transition shadow-[0_4px_14px_rgba(0,0,0,0.45),inset_0_1.5px_1.5px_rgba(255,245,220,0.4)]">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16"></path>
