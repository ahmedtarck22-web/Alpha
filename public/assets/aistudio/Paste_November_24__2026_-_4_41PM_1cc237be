<!DOCTYPE html>
<html lang="ar" dir="rtl" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alpha Go - الواجهة الرئيسية ولوحة التحكم</title>
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Load Google Fonts: Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #0d071b;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* Top Golden Header matching the reference Home Screen UI */
        .top-gold-arch {
            background: linear-gradient(180deg, #4b3822 0%, #3d2c1e 60%, #2b1d24 100%);
            border-bottom: 1.5px solid rgba(255, 209, 138, 0.75);
            box-shadow: 0 10px 26px rgba(0, 0, 0, 0.5), inset 0 1.5px 10px rgba(255, 232, 185, 0.35), inset 0 -1px 2px rgba(255, 209, 138, 0.45);
            border-bottom-left-radius: 32px;
            border-bottom-right-radius: 32px;
            overflow: hidden;
        }

        /* Static Glass & Gold Edge Reflection on all Widgets and Frames */
        .liquid-glass {
            background: linear-gradient(135deg, rgba(102, 54, 114, 0.42) 0%, rgba(42, 20, 62, 0.62) 100%);
            backdrop-filter: blur(22px) saturate(155%);
            -webkit-backdrop-filter: blur(22px) saturate(155%);
            border: 1.5px solid rgba(255, 209, 138, 0.72);
            box-shadow: 0 12px 36px rgba(20, 8, 34, 0.58), 0 0 18px rgba(255, 209, 138, 0.16), inset 0 2px 3px rgba(255, 246, 224, 0.48), inset 1.5px 0 2px rgba(255, 234, 195, 0.28), inset 0 -1.5px 3px rgba(255, 209, 138, 0.32);
            position: relative;
        }
        .liquid-glass::before {
            content: "";
            position: absolute;
            top: 0;
            left: 12%;
            right: 12%;
            height: 1.5px;
            background: linear-gradient(90deg, transparent, rgba(255, 250, 235, 0.9), transparent);
            pointer-events: none;
        }

        .liquid-glass-pill {
            background: linear-gradient(145deg, rgba(108, 58, 120, 0.46) 0%, rgba(45, 22, 66, 0.66) 100%);
            backdrop-filter: blur(24px) saturate(160%);
            -webkit-backdrop-filter: blur(24px) saturate(160%);
            border: 1.8px solid rgba(255, 209, 138, 0.85);
            box-shadow: 0 10px 30px rgba(20, 8, 34, 0.62), 0 0 20px rgba(255, 209, 138, 0.22), inset 0 2px 2.5px rgba(255, 246, 224, 0.5), inset 0 -1.5px 2px rgba(255, 209, 138, 0.35);
            position: relative;
        }
        .liquid-glass-pill::before {
            content: "";
            position: absolute;
            top: 0;
            left: 16%;
            right: 16%;
            height: 1.5px;
            background: linear-gradient(90deg, transparent, rgba(255, 252, 240, 0.92), transparent);
            pointer-events: none;
        }

        /* Static Metallic Gold Text Reflection on Key Headings */
        .gold-text-reflection {
            background: linear-gradient(115deg, #ffd18a 0%, #ffd18a 38%, #fff8e7 50%, #ffd18a 62%, #e6b05c 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 1px 4px rgba(255, 209, 138, 0.25));
        }

        .pill-active {
            background: linear-gradient(135deg, rgba(186, 104, 158, 0.42), rgba(76, 36, 92, 0.8));
            border: 1.5px solid #ffd18a !important;
            color: #ffd18a !important;
            box-shadow: 0 0 18px rgba(255, 209, 138, 0.35), inset 0 1.5px 1.5px rgba(255, 246, 225, 0.55);
        }

        /* Custom Scrollbar */
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(33, 17, 61, 0.3);
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 209, 138, 0.35);
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 209, 138, 0.65);
        }

        /* Drawer Slide Animation */
        .drawer-overlay {
            transition: opacity 0.35s ease-in-out, visibility 0.35s ease-in-out;
        }
        .drawer-panel {
            transition: transform 0.38s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 0 35px rgba(255, 209, 138, 0.28), 12px 0 30px rgba(0, 0, 0, 0.75);
        }
        .drawer-closed {
            transform: translateX(-105%);
        }
        .drawer-open {
            transform: translateX(0);
        }

        /* Phone Container Simulation */
        .phone-frame {
            width: 390px !important;
            max-width: 95vw !important;
            height: 820px !important;
            max-height: 88vh !important;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.85), 0 0 0 10px #1e152d;
            border-radius: 46px !important;
            overflow: hidden;
            position: relative;
        }

        /* Plus Menu Popover Animation */
        .plus-popover {
            transition: opacity 0.22s ease, transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
            transform-origin: bottom left;
        }
        .plus-popover-hidden {
            opacity: 0;
            transform: translateY(10px) scale(0.92);
            pointer-events: none;
        }
        .plus-popover-visible {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: auto;
        }

        /* Hieroglyphic Vertical Pillar Styling */
        .hiero-pillar {
            font-family: "Segoe UI Historic", "Noto Sans Egyptian Hieroglyphs", serif;
            text-shadow: 0 0 8px rgba(255, 209, 138, 0.35);
            letter-spacing: -1px;
        }
    </style>
</head>
<body class="h-full flex flex-col items-center justify-center min-h-screen bg-[#0d071b] text-gray-100 p-2 sm:p-4 selection:bg-[#ffd18a] selection:text-[#21113d]">

