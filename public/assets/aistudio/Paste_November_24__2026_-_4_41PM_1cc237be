            <span>𓋹𓍑𓋴</span>
            <span>𓇓𓏏𓈖</span>
            <span>𓅓𓂧𓏏</span>
            <span>𓅃𓇳</span>
            <span>𓃶𓏤</span>
            <span>𓀠𓆣</span>
            <span>𓂀𓄤</span>
            <span>𓆄𓏏</span>
            <span>𓊹𓉴</span>
            <span>𓀀𓁐𓏥</span>
            <span>𓂧𓏏</span>
            <span>𓋹𓆓</span>
            <span>𓅓𓇳</span>
            <span>𓅃𓂀</span>
            <span>𓃶𓈖</span>
            <span>𓆣𓇳</span>
