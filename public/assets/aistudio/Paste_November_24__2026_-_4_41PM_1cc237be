                            <h2 class="text-base sm:text-xl font-extrabold gold-text-reflection leading-snug">
                                أهلاً بك! في أي سنة دراسية أنت؟
                            </h2>
                        </div>

                        <!-- Explorer Mascot SVG -->
                        <div class="w-24 h-24 sm:w-28 sm:h-28 shrink-0 relative flex items-center justify-center">
                            <div class="absolute inset-1 rounded-full bg-[#ffd18a]/15 blur-md"></div>
                            <svg viewBox="0 0 120 120" class="w-full h-full relative z-10 drop-shadow-lg">
