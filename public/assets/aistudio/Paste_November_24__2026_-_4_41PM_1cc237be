            </div>

            <!-- Right User Avatar Button -->
            <button onclick="openAuthModal()" aria-label="تسجيل الدخول وحسابي" class="w-10 h-10 rounded-full bg-[#241638]/85 border-[1.5px] border-[#ffd18a]/75 flex items-center justify-center text-[#ffd18a] hover:scale-105 active:scale-95 transition shadow-[0_4px_14px_rgba(0,0,0,0.45),inset_0_1.5px_1.5px_rgba(255,245,220,0.4)]">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                </svg>
            </button>
        </div>

        <!-- 2. MAIN WORKSPACE (TAB VIEWS) -->
