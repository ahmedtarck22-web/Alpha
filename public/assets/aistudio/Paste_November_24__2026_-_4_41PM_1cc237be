                                <path d="M82 95 Q88 90 91 85" stroke="#d4a359" stroke-width="7" stroke-linecap="round"/>
                            </svg>
                        </div>
                    </div>

                    <!-- Grade Selection Pills -->
                    <div class="grid grid-cols-3 gap-2 sm:gap-3 mt-3">
                        <button onclick="selectGrade(this, 'أولى إعدادي')" class="grade-pill py-2 px-1.5 rounded-full bg-[#482357]/60 backdrop-blur-md border-[1.4px] border-[#ffd18a]/70 text-[#ffd18a] text-xs sm:text-sm font-bold hover:border-[#ffd18a] hover:shadow-[0_0_14px_rgba(255,209,138,0.3)] transition-all shadow-inner">
                            أولى إعدادي
                        </button>
                        <button onclick="selectGrade(this, 'تانية إعدادي')" class="grade-pill py-2 px-1.5 rounded-full bg-[#482357]/60 backdrop-blur-md border-[1.4px] border-[#ffd18a]/70 text-[#ffd18a] text-xs sm:text-sm font-bold hover:border-[#ffd18a] hover:shadow-[0_0_14px_rgba(255,209,138,0.3)] transition-all shadow-inner">
                            تانية إعدادي
                        </button>
                        <button onclick="selectGrade(this, 'تالتة إعدادي')" class="grade-pill py-2 px-1.5 rounded-full bg-[#482357]/60 backdrop-blur-md border-[1.4px] border-[#ffd18a]/70 text-[#ffd18a] text-xs sm:text-sm font-bold hover:border-[#ffd18a] hover:shadow-[0_0_14px_rgba(255,209,138,0.3)] transition-all shadow-inner">
